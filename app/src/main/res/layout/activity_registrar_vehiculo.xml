<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <include
        android:id="@+id/app_toolbar"
        layout="@layout/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/app_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar un vehículo"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="#222222"
                android:layout_marginBottom="24dp" />


            <EditText
                android:id="@+id/et_placa"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:hint="Placa"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="textCapCharacters" />


            <Spinner
                android:id="@+id/sp_marca"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:paddingHorizontal="12dp" />


            <Spinner
                android:id="@+id/sp_tipo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:paddingHorizontal="12dp" />


            <EditText
                android:id="@+id/et_modelo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:hint="Modelo"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="textCapWords" />


            <EditText
                android:id="@+id/et_anio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:hint="Año"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="number"
                android:maxLength="4" />


            <EditText
                android:id="@+id/et_costo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:hint="Costo por día"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="numberDecimal" />


            <Spinner
                android:id="@+id/sp_disponibilidad"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="28dp"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/btn_guardar_vehiculo"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:text="Registrar"
                android:textAllCaps="false"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>