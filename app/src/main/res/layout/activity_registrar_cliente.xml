<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

   <include
        android:id="@+id/app_toolbar"
        layout="@layout/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

   <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/app_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="24dp">

           <TextView
                android:id="@+id/tv_titulo_cliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar un cliente"
                android:textSize="20sp"
                android:textColor="#222222"
                android:layout_marginBottom="28dp" />

          <EditText
                android:id="@+id/et_identificacion_cliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:hint="Identificación (Número)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

          <EditText
                android:id="@+id/et_nombre_cliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:hint="Nombre"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />


            <EditText
                android:id="@+id/et_telefono_cliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="32dp"
                android:hint="Teléfono de contacto"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

           <Button
                android:id="@+id/btn_guardar_cliente"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:text="Registrar"
                android:textAllCaps="false"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>